    "bcryptjs": "^3.0.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "file-type": "^22.2.0",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "nodemailer": "^10.2.1",
    "pdfjs-dist": "^6.4.299",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "^2.18.1",
