# انسخ هذا الملف إلى .env واملأ القيم. لا تضع أسرارًا حقيقية في هذا الملف.

# قاعدة البيانات (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/alfeen"

# للتطوير المحلي دون تثبيت PostgreSQL: يشغّل npm run dev خادم PostgreSQL مدمجًا
# على المنفذ المذكور في DATABASE_URL. عطّله (0) عند استخدام خادم خارجي.
EMBEDDED_PG=1
EMBEDDED_PG_PASSWORD="ضع-كلمة-مرور-محلية-عشوائية"

# سر التطبيق (32 بايت عشوائية على الأقل بصيغة hex) لتوقيع الرموز
APP_SECRET=""

# العنوان العام للموقع (يُستخدم في روابط البريد)
APP_URL="http://localhost:3030"

# مجلد تخزين الملفات المرفوعة (public/ للوسائط المنشورة، private/ للمشاركات)
STORAGE_DIR="./storage"

# خدمة البريد (SMTP). عند تركها فارغة لا تُرسل أي رسائل، وتُبلَّغ الواجهة بذلك بصدق.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ألفين <no-reply@example.com>"
# بريد الفريق لاستلام إشعارات التواصل والمشاركات
TEAM_NOTIFY_EMAIL=""

# للتطوير فقط: إظهار صندوق البريد الصادر في لوحة الإدارة لاختبار الروابط دون SMTP
EMAIL_DEV_OUTBOX=0

# حساب المدير الأول (يُستخدم مرة واحدة في npm run db:seed ثم احذفه)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
